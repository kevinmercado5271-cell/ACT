def newfile():
    text_editor.delete("1.0", tk.END)
    text_editor.insert(tk.END, "# Start typing your Python code here...\n")
    statusbar.config(text="New file created")


def openfile():
    filename = filedialog.askopenfilename(
        title="Open File",
        filetypes=[
            ("Python Files", "*.py"),
            ("Text Files", "*.txt"),
            ("All Files", "*.*")
        ]
    )

    if filename:
        with open(filename, "r", encoding="utf-8") as f:
            content = f.read()

        text_editor.delete("1.0", tk.END)
        text_editor.insert(tk.END, content)

        statusbar.config(text=f"Opened: {Path(filename).name}")


def savefile():
    filename = filedialog.asksaveasfilename(
        defaultextension=".txt",
        filetypes=[
            ("Text Files", "*.txt"),
            ("Python Files", "*.py"),
            ("All Files", "*.*")
        ],
        title="Save File"
    )

    if filename:
        with open(filename, "w", encoding="utf-8") as f:
            f.write(text_editor.get("1.0", tk.END))

        statusbar.config(text=f"Saved: {Path(filename).name}")
        messagebox.showinfo("Save", "File saved successfully!")


def exitprogram():
    if messagebox.askokcancel("Exit", "Do you really want to quit?"):
        window.destroy()


