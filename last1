# ---------------- FIXED RUN CODE ---------------- #

def run_code():
    code = text_editor.get("1.0", tk.END)

    output_buffer = io.StringIO()

    old_stdout = sys.stdout
    old_stderr = sys.stderr

    sys.stdout = output_buffer
    sys.stderr = output_buffer

    try:
        exec(code, {"__builtins__": __builtins__})
    except Exception as e:
        print("Error:", e)

    sys.stdout = old_stdout
    sys.stderr = old_stderr

    show_output(output_buffer.getvalue())
    statusbar.config(text="Code executed")


# ---------------- OUTPUT ---------------- #

def show_output(text):
    output_frame.pack(side=tk.BOTTOM, fill=tk.X)

    output_text.config(state=tk.NORMAL)
    output_text.delete("1.0", tk.END)
    output_text.insert(tk.END, text if text else "No output")
    output_text.config(state=tk.DISABLED)


def hide_output():
    output_frame.pack_forget()


# ---------------- EDITOR ---------------- #

editor_frame = tk.Frame(window, bg="#2b2b2b")
editor_frame.pack(fill=tk.BOTH, expand=True)

text_editor = tk.Text(
    editor_frame,
    wrap=tk.NONE,
    undo=True,
    bg="#1e1e1e",
    fg="#dcdcdc",
    insertbackground="white",
    selectbackground="#555555",
    font=("Consolas", 12)
)

scroll_y = ttk.Scrollbar(editor_frame, orient=tk.VERTICAL, command=text_editor.yview)
scroll_x = ttk.Scrollbar(editor_frame, orient=tk.HORIZONTAL, command=text_editor.xview)

text_editor.configure(yscrollcommand=scroll_y.set, xscrollcommand=scroll_x.set)

text_editor.grid(row=0, column=0, sticky="nsew")
scroll_y.grid(row=0, column=1, sticky="ns")
scroll_x.grid(row=1, column=0, sticky="ew")

editor_frame.rowconfigure(0, weight=1)
editor_frame.columnconfigure(0, weight=1)


